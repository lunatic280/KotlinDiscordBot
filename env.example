# GitHub Container Registry image. Production deploys replace the tag with a commit SHA.
APP_IMAGE=ghcr.io/lunatic280/kotlindiscordbot-ops:latest

# Supabase Session pooler (IPv4), not the IPv6-only direct endpoint.
DB_URL='jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=discordbot&ApplicationName=kotlin-discord-bot'
DB_USERNAME='postgres.uomrpfkorbrvucsviibw'
DB_PASSWORD='replace-with-supabase-database-password'
DDL_AUTO='validate'
SHOW_SQL='false'

# Keep the application-side pool small because Supabase already provides a pooler.
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=10000
DB_KEEPALIVE_TIME_MS=120000
DB_MAX_LIFETIME_MS=1800000

# Discord
DISCORD_TOKEN='replace-with-discord-bot-token'
DISCORD_GUILD_ID=''

# External APIs
PUBG_API_KEY='replace-with-pubg-api-key'
GEMMA_API_KEY=''
GEMMA_BASE_URL='https://generativelanguage.googleapis.com'
ALADIN_TTB_KEY=''

# Optional JVM override
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=20 -XX:+ExitOnOutOfMemoryError'
