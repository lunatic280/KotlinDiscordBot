spring:
  main:
    web-application-type: none

  application:
    name: KotlinBot

  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/discordbot_db}
    username: ${DB_USERNAME:discordbot}
    password: ${DB_PASSWORD:}
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: ${DB_MAX_POOL_SIZE:5}
      minimum-idle: ${DB_MIN_IDLE:1}
      connection-timeout: ${DB_CONNECTION_TIMEOUT_MS:10000}
      keepalive-time: ${DB_KEEPALIVE_TIME_MS:120000}
      max-lifetime: ${DB_MAX_LIFETIME_MS:1800000}

  jpa:
    hibernate:
      ddl-auto: ${DDL_AUTO:validate}
    show-sql: ${SHOW_SQL:false}
    open-in-view: false

discord:
  token: ${DISCORD_TOKEN:}
  guild-id: ${DISCORD_GUILD_ID:}

jda:
  intents: ${JDA_INTENTS:}

botcommands:
  owners: ${BOTCOMMANDS_OWNERS:}
  prefixes:

pubg:
  api-key: ${PUBG_API_KEY:}

gemma:
  api-key: ${GEMMA_API_KEY:}
  base-url: ${GEMMA_BASE_URL:https://generativelanguage.googleapis.com}
  system-prompt: ${GEMMA_SYSTEM_PROMPT:너는 Discord 봇에서 동작하는 한국어 AI 어시스턴트입니다. 답변은 간결하고 정확하게 한국어로 작성하세요.}

aladin:
  api:
    key: ${ALADIN_TTB_KEY:}
